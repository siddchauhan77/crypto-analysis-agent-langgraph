OPENAI_API_KEY=
FREECRYPTO_API_KEY=
NEWS_API_KEY=
DEMO_ACCESS_CODE=
ADMIN_ACCESS_CODE=

# Model and network defaults.
OPENAI_MODEL=gpt-4o-mini
REQUEST_TIMEOUT_SECONDS=15
MAX_HTTP_RETRIES=2
CHECKPOINT_DB_PATH=.data/crypto-agent.sqlite3

# Optional tracing. Leave disabled during initial development.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=crypto-analysis-agent
